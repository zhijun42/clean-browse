{
  "manifest_version": 3,
  "name": "清净浏览 — Bilibili & 知乎",
  "description": "清理 Bilibili 与知乎的搜索推荐词，隐藏 B 站直播卡片、知乎热搜和广告，保留正常搜索与阅读。",
  "version": "1.1.0",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "css": ["bilibili.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.zhihu.com/*"],
      "js": ["content.js"],
      "css": ["zhihu.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
